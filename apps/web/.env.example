# Browser -> main Thamizhi API
# The main API handles services such as TTS.
NEXT_PUBLIC_API_BASE_URL=http://YOUR_HOST:8000/api/v1

# Next.js server -> ThamizhiOCR Docker backend
# Server-side only. Do NOT prefix this with NEXT_PUBLIC_.
OCR_BACKEND_URL=http://YOUR_HOST:8768
